{"text": "<meta name=\"dash-one-writer\">\n<title>CCS Max Hourly Volumes</title>\n<style>\n  .dash-page { font-family: var(--font-anthropic-sans); color: var(--color-fg); }\n  .dash-page h1 {\n    font-family: var(--font-anthropic-serif);\n    font-weight: 400;\n    font-size: var(--cds-font-size-title);\n    margin: 0 0 var(--cds-gap-xs) 0;\n  }\n  .dash-page .lede {\n    color: var(--color-fg-muted);\n    font-size: var(--cds-font-size-body);\n    max-width: 68ch;\n    margin: 0 0 var(--cds-gap-lg) 0;\n  }\n  .summary-strip {\n    display: flex;\n    flex-wrap: wrap;\n    gap: var(--cds-gap-sm);\n    margin-bottom: var(--cds-gap-lg);\n  }\n  .summary-strip .stat {\n    background: var(--color-panel);\n    border: 1px solid var(--color-border-line);\n    border-radius: var(--cds-radius);\n    padding: var(--cds-pad-sm) var(--cds-pad-md);\n    min-width: 7.5rem;\n  }\n  .summary-strip .stat .num {\n    font-family: var(--font-anthropic-serif);\n    font-weight: 400;\n    font-size: var(--cds-font-size-heading);\n    font-variant-numeric: tabular-nums;\n    display: block;\n  }\n  .summary-strip .stat .label {\n    font-size: var(--cds-font-size-caption);\n    color: var(--color-fg-muted);\n  }\n  .controls {\n    display: flex;\n    align-items: center;\n    gap: var(--cds-gap-sm);\n    margin-bottom: var(--cds-gap-md);\n  }\n  .controls label {\n    display: flex;\n    align-items: center;\n    gap: var(--cds-gap-xs);\n    font-size: var(--cds-font-size-caption);\n    color: var(--color-fg-muted);\n  }\n  .ft-table-wrap, .table-wrap {\n    overflow-x: auto;\n    border: 1px solid var(--color-border-line);\n    border-radius: var(--cds-radius);\n    margin-bottom: var(--cds-gap-lg);\n  }\n  table {\n    border-collapse: collapse;\n    width: 100%;\n    font-size: var(--cds-font-size-body);\n  }\n  thead th {\n    position: sticky;\n    top: 0;\n    background: var(--color-panel);\n    text-align: left;\n    font-size: var(--cds-font-size-caption);\n    color: var(--color-fg-muted);\n    font-weight: var(--cds-font-weight-medium);\n    padding: var(--cds-pad-sm);\n    border-bottom: 1px solid var(--color-border-line);\n    white-space: nowrap;\n  }\n  tbody td {\n    padding: var(--cds-pad-sm);\n    border-bottom: 1px solid var(--color-border-line);\n    white-space: nowrap;\n  }\n  tbody tr:last-child td { border-bottom: none; }\n  td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; }\n  td.muted { color: var(--color-fg-muted); }\n  .ft-table-wrap table { width: auto; min-width: 100%; }\n</style>\n\n<div class=\"dash-page\">\n  <h1>CCS Max Hourly Volumes</h1>\n  <p class=\"lede\" data-draw=\"lede\">\u2014</p>\n\n  <div class=\"summary-strip\">\n    <div class=\"stat\"><span class=\"num\" data-draw=\"n-stations\">\u2014</span><span class=\"label\">stations</span></div>\n    <div class=\"stat\"><span class=\"num\" data-draw=\"n-with-vol\">\u2014</span><span class=\"label\">with a volume</span></div>\n    <div class=\"stat\"><span class=\"num\" data-draw=\"n-ft-groups\">\u2014</span><span class=\"label\">FT groups</span></div>\n  </div>\n\n  <h2 style=\"font-family:var(--font-anthropic-serif); font-weight:400; font-size:var(--cds-font-size-heading); margin: 0 0 var(--cds-gap-sm) 0;\">By facility type</h2>\n  <div class=\"ft-table-wrap\">\n    <table data-source=\"ft_summary\" data-row-key=\"ft\">\n      <thead>\n        <tr>\n          <th data-field=\"ft\">FT</th>\n          <th data-field=\"ftclass\">Facility class</th>\n          <th class=\"num\" data-field=\"n_stations\">Stations</th>\n          <th class=\"num\" data-field=\"n_with_vol\">With volume</th>\n          <th class=\"num\" data-field=\"max_of_max\">Max of max-hourly</th>\n          <th class=\"num\" data-field=\"avg_of_max\">Avg of max-hourly</th>\n          <th class=\"num\" data-field=\"avg_cap_assumed\">Avg spdcap capacity</th>\n          <th class=\"num\" data-field=\"avg_pct_of_cap\">Avg % of capacity</th>\n        </tr>\n      </thead>\n      <tbody data-draw=\"ft-rows\">\n        <tr><td colspan=\"8\">\u2014</td></tr>\n      </tbody>\n    </table>\n  </div>\n\n  <div class=\"controls\">\n    <label>Filter by facility type\n      <select class=\"dash-select\" data-draw=\"ft-filter\" data-source=\"ccs_volumes\" aria-label=\"Facility type filter\"></select>\n    </label>\n  </div>\n\n  <div class=\"table-wrap\">\n    <table data-source=\"filtered\" data-row-key=\"site\">\n      <thead>\n        <tr>\n          <th data-field=\"site\">Site</th>\n          <th data-field=\"description\">Location</th>\n          <th data-field=\"county\">County</th>\n          <th data-field=\"street\">Link street</th>\n          <th data-field=\"ft\">FT</th>\n          <th data-field=\"ftclass\">Facility class</th>\n          <th class=\"num\" data-field=\"lanes\">Lanes</th>\n          <th class=\"num\" data-field=\"cap_assumed\">spdcap capacity</th>\n          <th class=\"num\" data-field=\"max_hourly_vol\">Max hourly vol</th>\n          <th class=\"num\" data-field=\"pct_of_cap\">% of capacity</th>\n          <th data-field=\"date\">Date</th>\n          <th data-field=\"hour\">Hour</th>\n        </tr>\n      </thead>\n      <tbody data-draw=\"rows\">\n        <tr><td colspan=\"12\">\u2014</td></tr>\n      </tbody>\n    </table>\n  </div>\n</div>\n\n<script>\n  function hourLabel(h) {\n    if (!h) return '';\n    const hh = h.replace('H', '').slice(0, 2);\n    return hh + ':00';\n  }\n\n  dash.calc('ft_summary', {\n    inputs: ['ccs_volumes'],\n    fn: (rows) => {\n      const groups = d3.groups(rows, (r) => r.ft)\n        .sort((a, b) => d3.ascending(a[0], b[0]));\n      return groups.map(([ft, g]) => {\n        const withVol = g.filter((r) => r.max_hourly_vol != null);\n        const vols = withVol.map((r) => r.max_hourly_vol);\n        const pcts = withVol.map((r) => r.pct_of_cap);\n        return {\n          ft,\n          ftclass: g[0].ftclass,\n          n_stations: g.length,\n          n_with_vol: withVol.length,\n          max_of_max: vols.length ? d3.max(vols) : null,\n          avg_of_max: vols.length ? Math.round(d3.mean(vols)) : null,\n          avg_cap_assumed: Math.round(d3.mean(g, (r) => r.cap_assumed)),\n          avg_pct_of_cap: pcts.length ? Math.round(d3.mean(pcts)) : null,\n        };\n      });\n    },\n  });\n\n  dash.calc('filtered', {\n    inputs: ['ccs_volumes'],\n    fn: (rows) => {\n      const { ft } = dash.params();\n      return ft ? rows.filter((r) => String(r.ft) === String(ft)) : rows;\n    },\n  });\n\n  dash.draw('lede', (el) => {\n    const g = dash.data('ccs_volumes');\n    if (g.status !== 'ok') { el.textContent = '\u2014'; return; }\n    const rows = g.data;\n    const withVol = rows.filter((r) => r.max_hourly_vol != null).length;\n    el.textContent = `Max single-lane, single-direction hourly volume for every CCS station on the filtered network (centroid connectors, ramps and HOV links excluded; 5 implausible outlier stations and 3 stations in mountainous TAZ zones (MARGINAL=1) dropped), restricted to the Sept 1 \u2013 Nov 15 2023 Tue\u2013Thu calibration window, compared against the TDM's own spdcap-table capacity assumption (CAP1HR1LN, from Lookup_Speed_Capacity.csv by FT and lane count) for the station's matched link. Bangerter Hwy stations classed Expressway (FT 13/15) are also excluded, since Bangerter is being converted to a freeway and its current FT may not represent it well. ${withVol} of ${rows.length} stations have usable 2023 hourly-by-lane data.`;\n  });\n\n  dash.draw('n-stations', (el) => {\n    const g = dash.data('ccs_volumes');\n    el.textContent = g.status === 'ok' ? g.data.length : '\u2014';\n  });\n\n  dash.draw('n-with-vol', (el) => {\n    const g = dash.data('ccs_volumes');\n    el.textContent = g.status === 'ok' ? g.data.filter((r) => r.max_hourly_vol != null).length : '\u2014';\n  });\n\n  dash.draw('n-ft-groups', (el) => {\n    const g = dash.data('ft_summary');\n    el.textContent = g.status === 'ok' ? g.data.length : '\u2014';\n  });\n\n  dash.draw('ft-rows', (el) => {\n    const g = dash.data('ft_summary');\n    if (g.status !== 'ok') { el.replaceChildren(); return; }\n    const sel = d3.select(el).selectAll('tr').data(g.data, (d) => d.ft);\n    sel.exit().remove();\n    const rows = sel.enter().append('tr').merge(sel);\n    rows.html('');\n    rows.append('td').text((d) => d.ft);\n    rows.append('td').text((d) => d.ftclass);\n    rows.append('td').attr('class', 'num').text((d) => d.n_stations);\n    rows.append('td').attr('class', 'num').text((d) => d.n_with_vol);\n    rows.append('td').attr('class', 'num').text((d) => (d.max_of_max != null ? d3.format(',')(d.max_of_max) : '\u2014'));\n    rows.append('td').attr('class', 'num').text((d) => (d.avg_of_max != null ? d3.format(',')(d.avg_of_max) : '\u2014'));\n    rows.append('td').attr('class', 'num').text((d) => d3.format(',')(d.avg_cap_assumed));\n    rows.append('td').attr('class', 'num').text((d) => (d.avg_pct_of_cap != null ? `${d.avg_pct_of_cap}%` : '\u2014'));\n  });\n\n  dash.draw('ft-filter', (el) => {\n    const g = dash.data('ft_summary');\n    const opts = g.status === 'ok' ? g.data.map((d) => d.ft) : [];\n    el.replaceChildren(\n      new Option('All facility types', ''),\n      ...opts.map((ft) => new Option(`FT ${ft}`, ft))\n    );\n    el.value = dash.params().ft ?? '';\n    el.onchange = () => dash.setParams({ ft: el.value || null });\n  });\n\n  dash.draw('rows', (el) => {\n    const g = dash.data('filtered');\n    if (g.status !== 'ok') { el.replaceChildren(); return; }\n    const sel = d3.select(el).selectAll('tr').data(g.data, (d) => d.site);\n    sel.exit().remove();\n    const rows = sel.enter().append('tr').merge(sel);\n    rows.html('');\n    rows.append('td').text((d) => d.site);\n    rows.append('td').text((d) => d.description || '');\n    rows.append('td').attr('class', 'muted').text((d) => d.county || '');\n    rows.append('td').text((d) => d.street || '');\n    rows.append('td').text((d) => d.ft);\n    rows.append('td').text((d) => d.ftclass);\n    rows.append('td').attr('class', 'num').text((d) => d.lanes);\n    rows.append('td').attr('class', 'num').text((d) => d3.format(',')(d.cap_assumed));\n    rows.append('td').attr('class', 'num').text((d) => (d.max_hourly_vol != null ? d3.format(',')(d.max_hourly_vol) : '\u2014'));\n    rows.append('td').attr('class', 'num').text((d) => (d.pct_of_cap != null ? `${Math.round(d.pct_of_cap)}%` : '\u2014'));\n    rows.append('td').attr('class', 'muted').text((d) => d.date || '');\n    rows.append('td').attr('class', 'muted').text((d) => hourLabel(d.hour));\n  });\n</script>\n"}